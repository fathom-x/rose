# zecd Bitcoin UI Environment Configuration
#
# Copy this file to .env (DO NOT COMMIT .env to git - it contains secrets)
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual values
#   docker compose -f docker-compose.btc-testnet4.yml up -d
#
# Different networks use different files:
#   - Testnet4:  docker-compose.btc-testnet4.yml
#   - Testnet3:  docker-compose.btc-testnet3.yml
#   - Mainnet:   docker-compose.btc-mainnet.yml
#
# You can also create network-specific .env files:
#   - .env.testnet4
#   - .env.testnet3
#   - .env.mainnet
#
# Then use them with:
#   docker compose --env-file .env.mainnet -f docker-compose.btc-mainnet.yml up -d

# ============================================================================
# ZECD RPC CREDENTIALS
# ============================================================================

# The password zecd uses for RPC authentication.
# Must match the [rpc] password in the corresponding zecd.btc-<network>.toml config.
#
# SECURITY: Use a strong, random password for mainnet. For testnets (valueless coins),
# a simple value like "zecd" is fine for local development.
#
# For mainnet: Generate with: openssl rand -base64 32
ZECD_RPC_PASSWORD=zecd

# The username for zecd RPC (usually read from the config file, but can override here if needed).
# Only needed if you're using a non-standard setup.
# ZECD_RPC_USER=user

# ============================================================================
# UI CONFIGURATION (Optional)
# ============================================================================

# UI server bind address inside the container (almost always 0.0.0.0 for Docker).
# The compose file handles the external port binding (loopback vs public).
# UI_BIND=0.0.0.0

# UI server port inside the container (default 8080).
# The compose file remaps this to an external port (8080, 8081, etc).
# UI_PORT=8080

# ============================================================================
# BITCOIND / CHAIN CONFIGURATION (Optional)
# ============================================================================

# bitcoind JSON-RPC endpoint for fee estimates (testnet only, not used by mainnet kyoto).
# The UI queries this to show estimated fees when you have `[bitcoind]` credentials
# in your zecd config. Leave blank or commented to disable fee estimates.
#
# Testnet4: http://bitcoind:48332 (inside compose stack)
# Testnet3: http://bitcoind:18332 (inside compose stack)
# Mainnet:  not needed (kyoto uses mempool.space)
# BITCOIND_RPC_URL=http://bitcoind:48332

# ============================================================================
# DOCKER COMPOSE SETTINGS
# ============================================================================

# Set a custom compose project name (normally derived from the directory).
# Useful if you're running multiple stacks and want to control naming.
# COMPOSE_PROJECT_NAME=zecd-btc-mainnet

# Set a custom Docker network name.
# Normally set in the compose file; override here if needed.
# COMPOSE_NETWORK=zecd-mainnet

# ============================================================================
# MAINNET-SPECIFIC SETTINGS
# ============================================================================

# Path to the bitcoind datadir (mainnet only, production).
# This should be an existing directory with a synced Bitcoin blockchain.
# On production hosts, typically /mnt/data/bitcoin_data or /var/lib/bitcoin
#
# IMPORTANT: This MUST already be synced before starting the container.
# The compose file expects this path at /mnt/data/bitcoin_data by default.
# Only override if your setup is different.
# BITCOIN_DATADIR=/mnt/data/bitcoin_data

# ============================================================================
# DEVELOPMENT / DEBUGGING (Usually not needed)
# ============================================================================

# Enable Docker buildkit for faster image builds (recommended).
# DOCKER_BUILDKIT=1

# Set to 1 to keep containers running even if they fail to start.
# Useful for debugging startup issues.
# DEBUG=0

# ============================================================================
# GIT IGNORE WARNING
# ============================================================================
#
# DO NOT COMMIT THIS FILE WITH REAL CREDENTIALS TO GIT!
#
# Add to your .gitignore:
#   echo ".env" >> .gitignore
#   echo ".env.local" >> .gitignore
#   echo ".env.mainnet" >> .gitignore
#   echo ".env.testnet*" >> .gitignore
#
# Safe alternatives for version control:
# - Check in .env.example (this file) as a template
# - Store real .env in a secure location (1Password, LastPass, AWS Secrets Manager, etc)
# - Use CI/CD secrets for production deployments
#
# Verify nothing is checked in:
#   git diff --cached | grep "ZECD_RPC_PASSWORD\|rpc_password"
#   git log -p | grep "ZECD_RPC_PASSWORD\|rpc_password"  # check history too

# Mainnet node (docker-compose.btc-mainnet.yml), both optional: the connection ceiling and
# the subnet whose connections are never evicted (the compose network's, where the host's
# own clients - the paced relay, local wallets - arrive from). Change the subnet only if
# the compose network's subnet was changed on this host.
# BTC_MAXCONNECTIONS=200
# BTC_WHITELIST_SUBNET=172.28.0.0/24

