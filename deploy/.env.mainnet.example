# Environment for the mainnet stack (deploy/docker-compose.btc-mainnet.yml). REAL MONEY.
#
# Compose reads `.env` from its project directory, which is this directory for
# `docker compose -f deploy/docker-compose.btc-mainnet.yml`. So:
#
#   cp deploy/.env.mainnet.example deploy/.env      # gitignored (every .env / .env.* is)
#
# One variable. It is the RPC password of the host rose - the spend credential - and it
# must be set in BOTH places: here for the rose-gui container, and in the environment of
# the rose daemon on the host (deploy/rose.btc-mainnet.toml ships the CHANGE-ME placeholder
# that rose refuses to start on; the variable wins over the file). Never edit the password
# into the toml.
#
#   ROSE_RPC_PASSWORD=$(openssl rand -base64 24)
#
# Rotation: change it here, restart the host daemon with the new value in its environment,
# then `docker compose -f deploy/docker-compose.btc-mainnet.yml up -d rose-gui`.
ROSE_RPC_PASSWORD=CHANGE-ME
