# Testnet3 Environment Configuration
#
# Copy to .env.testnet3 and use with:
#   docker compose --env-file .env.testnet3 -f docker-compose.btc-testnet3.yml up -d
#

# RPC password for rose (testnet coins are valueless, so a simple password is fine)
ROSE_RPC_PASSWORD=rose

# Optional: override UI port (default: 8080 -> external 127.0.0.1:8081)
# UI_PORT=8080

# Optional: the name the UI's header shows for this machine. The UI container's own hostname
# is a random id, so without this the header says "container <id>". E.g. the output of
# `hostname` on the machine running the stack.
# ROSE_GUI_MACHINE=
