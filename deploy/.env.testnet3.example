# Testnet3 Environment Configuration
#
# Copy to .env.testnet3 and use with:
#   docker compose --env-file .env.testnet3 -f docker-compose.btc-testnet3.yml up -d
#

# RPC password for zecd (testnet coins are valueless, so a simple password is fine)
ZECD_RPC_PASSWORD=zecd

# Optional: override UI port (default: 8080 -> external 127.0.0.1:8081)
# UI_PORT=8080

# Optional: bitcoind RPC for fee estimates (internal Docker DNS, testnet3 uses port 18332)
# BITCOIND_RPC_URL=http://bitcoind:18332
