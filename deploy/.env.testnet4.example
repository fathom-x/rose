# Testnet4 stack settings, read by docker-compose.btc-testnet4.yml.
#
#   cp deploy/.env.testnet4.example deploy/.env      # then fill in ZECD_RPC_PASSWORD
#   docker compose -f deploy/docker-compose.btc-testnet4.yml up -d zecd-gui
#
# The filename matters: compose loads `.env` from its PROJECT directory, which is the
# directory of the first -f file - so deploy/.env, not a repo-root .env and not a
# .env.testnet4. Pass any other name explicitly with --env-file.

# Which config the UI serves, and the [rpc] port that config listens on. The two must agree;
# only the host part of the address is overridden (to reach a zecd on the host).
#   zecd.btc-testnet4.toml        port 48232  full mode against this stack's bitcoind
#   zecd.btc-testnet4-kyoto.toml  port 48242  kyoto light mode, no bitcoind needed
ZECD_GUI_CONF=zecd.btc-testnet4-kyoto.toml
ZECD_GUI_RPC_PORT=48242

# zecd's RPC password. REQUIRED, and the same value in two places: both testnet4 configs ship
# the CHANGE-ME placeholder, which zecd refuses to start on (every network, testnet included),
# so the host daemon needs this variable in its environment (it wins over the config file) -
# and the UI proxy reads the same variable to authenticate. Compose refuses to start the UI
# while it is empty.
ZECD_RPC_PASSWORD=
